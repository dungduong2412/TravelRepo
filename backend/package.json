{
  "name": "travelrepo-backend",
  "version": "1.0.0",
  "description": "Backend API for TravelRepo - Supabase-based NestJS application",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/main.ts",
    "start": "node dist/main.js",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts'",
    "test:d6-contracts": "node -r ts-node/register/transpile-only scripts/test-d6-contracts.ts",
    "test:media-lifecycle": "node -r ts-node/register/transpile-only scripts/test-media-lifecycle.ts",
    "test:d13a-contracts": "node -r ts-node/register/transpile-only scripts/test-d13a-contracts.ts",
    "test:invitation-guards": "node -r ts-node/register/transpile-only scripts/test-invitation-claim-guards.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@supabase/supabase-js": "^2.38.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.4.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^9.39.5",
    "ts-node": "^10.9.0",
    "typescript-eslint": "^8.71.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "body-parser": "2.4.0",
    "multer": "2.5.0"
  }
}
