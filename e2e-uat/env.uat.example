# Copy to .env.uat.local (git-ignored). Never commit, paste or log the real values.
# Target (fixed to UAT; the suite refuses any other host)
E2E_WEB_URL=https://vno-web-uat.up.railway.app
E2E_API_URL=https://vno-api-uat.up.railway.app
E2E_SUPABASE_URL=https://hsezyogfxgnkpweoqqny.supabase.co
# Public anon key (same value the web bundle ships). Optional: auto-discovered from the web bundle when blank.
E2E_SUPABASE_ANON_KEY=

# Synthetic identities. Each must be a real, verified Supabase Auth user (see README).
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_MERCHANT_EMAIL=
E2E_MERCHANT_PASSWORD=
E2E_PARTNER_EMAIL=
E2E_PARTNER_PASSWORD=
# A SECOND verified synthetic user with no profile, used only for tenant/claim negative tests (optional)
E2E_OUTSIDER_EMAIL=
E2E_OUTSIDER_PASSWORD=
