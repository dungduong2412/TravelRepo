{
  "name": "vno-uat-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-based full-flow regression suite for the VNO V2 Railway UAT",
  "scripts": {
    "test:e2e:uat": "playwright test",
    "test:e2e:uat:headed": "playwright test --headed",
    "test:e2e:uat:smoke": "playwright test --grep @unauth",
    "fixture:adopt": "tsx lib/adopt-fixture.ts",
    "report": "playwright show-report evidence/html-report",
    "typecheck": "tsc --noEmit",
    "test:e2e:candidate": "E2E_TARGET=candidate playwright test tests/00-unauth.spec.ts tests/40-experience.spec.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3"
  }
}
