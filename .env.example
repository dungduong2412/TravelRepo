# Backend runtime
PORT=3100

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CORS_ORIGINS=http://localhost:3001

# JWT Configuration (optional, for custom auth)
JWT_ISSUER=
JWT_AUDIENCE=

# --- UAT e-mail (Auth Send Email hook gateway + admin invitations). Provider-neutral SMTP; see docs/VNO_V2_UAT_EMAIL_GATE_B_RUNBOOK_20261102.md.
# Never put real values here; set them in Railway (API service) only. Delivery stays OFF unless AUTH_EMAIL_DELIVERY=enabled.
AUTH_EMAIL_DELIVERY=disabled
AUTH_EMAIL_HOOK_SECRET=
AUTH_EMAIL_ALLOWLIST=
AUTH_EMAIL_SUBJECT_PREFIX=[UAT] 
INVITATION_DELIVERY=capture
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_REPLY_TO=
